# ==============================================================================
# Firebase Client Configuration — Proyecto "cumple-julia-15" (Spark Plan)
# ==============================================================================
# Obtené apiKey y appId en:
# Firebase Console -> Configuración del proyecto (engranaje) -> General -> Tus apps -> Web (</>)
# 
# NOTA: En Netlify, cargar estas mismas variables en:
# Site configuration -> Environment variables -> Add a variable

NEXT_PUBLIC_FIREBASE_PROJECT_ID=cumple-julia-15
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cumple-julia-15.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cumple-julia-15.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=175873195765

# Completar con los valores específicos de la App Web creada en Firebase Console:
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_APP_ID=1:175873195765:web:...

# ==============================================================================
# Email Notifications (Opcional - Notificaciones de respaldo)
# ==============================================================================
RESEND_API_KEY=re_xxxxxxxxxxxx
RSVP_RECIPIENT_EMAIL=jviera97@gmail.com
